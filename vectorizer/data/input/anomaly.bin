#!/bin/bash
# This file has a .bin extension but is actually a shell script
# This should be detected as an anomaly

echo "This is an anomalous file"
echo "It has binary extension but text content"

# Add some binary-like content
echo -e "\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0A"
echo -e "\xFF\xFE\xFD\xFC\xFB\xFA\xF9\xF8\xF7\xF6"

exit 0
