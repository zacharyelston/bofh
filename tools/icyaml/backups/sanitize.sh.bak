#!/bin/bash
# ICYAML Sanitize Script
# Removes or anonymizes sensitive paths and references in code files
# to ensure no proprietary information is committed to the repository

# Get the directory where this script is located
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

echo "🧹 ICYAML Code Sanitizer"
echo "======================="
echo "Sanitizing files to remove sensitive paths and references..."

# Create a backup directory
BACKUP_DIR="$SCRIPT_DIR/backups"
mkdir -p "$BACKUP_DIR"
echo "Created backup directory: $BACKUP_DIR"

# First, let's create backups of all files to be modified
echo "Creating backups of all files..."
find "$SCRIPT_DIR" -type f \( -name "*.sh" -o -name "*.py" -o -name "*.md" -o -name "*.yml" -o -name "*.yaml" \) | while read file; do
    if [ -f "$file" ]; then
        filename=$(basename "$file")
        cp "$file" "$BACKUP_DIR/${filename}.bak"
    fi
done
echo "✅ Backups created"

# Function to sanitize a file
sanitize_file() {
    local file="$1"
    local filename=$(basename "$file")
    
    # Skip backups and already sanitized files
    if [[ "$file" == *".bak"* ]] || [[ "$file" == *".sanitized"* ]]; then
        return
    fi
    
    # Skip if file doesn't exist
    if [ ! -f "$file" ]; then
        return
    fi
    
    echo "Sanitizing: $filename"
    
    # Create a temporary file
    local temp_file="${file}.tmp"
    
    # Replace specific hardcoded paths and references
    sed -e 's|/Users/zacelston/CODE/CFA|$SOURCE_DIR|g' \
        -e 's|../../../CODE/CFA|$SOURCE_DIR|g' \
        -e 's|CFA_PATH|SOURCE_DIR|g' \
        -e 's|CFA ordering-atlas|YAML configuration files|g' \
        -e 's|CFA Ordering Atlas|YAML configuration files|g' \
        -e 's|CFA/sc-ordering-atlas|$SOURCE_DIR|g' \
        -e 's|sc-ordering-atlas|$SOURCE_DIR|g' \
        -e 's|zacelston@ZEMBA|user@host|g' \
        "$file" > "$temp_file"
    
    # Replace the original file
    mv "$temp_file" "$file"
}

# Sanitize all relevant files
echo "Sanitizing files..."
find "$SCRIPT_DIR" -type f \( -name "*.sh" -o -name "*.py" -o -name "*.md" -o -name "*.yml" -o -name "*.yaml" \) | while read file; do
    sanitize_file "$file"
done

# Clean up the output directory
OUTPUT_PATH="$(dirname "$(dirname "$SCRIPT_DIR")")/output"
if [ -d "$OUTPUT_PATH" ]; then
    echo "Removing output directory contents..."
    rm -rf "$OUTPUT_PATH"/*
    echo "✅ Cleaned output directory: $OUTPUT_PATH"
else
    echo "⚠️ Output directory not found: $OUTPUT_PATH"
fi

# Remove temporary files
echo "Removing temporary files..."
find "$SCRIPT_DIR" -name "*.tmp" -delete

# Create a .gitignore file if it doesn't exist
GITIGNORE_PATH="$(dirname "$(dirname "$SCRIPT_DIR")")/.gitignore"
if [ ! -f "$GITIGNORE_PATH" ]; then
    echo "Creating .gitignore file..."
    cat > "$GITIGNORE_PATH" << EOF
# ICYAML generated files and backups
output/
backups/
*.json
*_report.json
*_report.txt
*.yaml.tmp
*_fixed
*.bak
*.sanitized
*.tmp

# Editor and system files
.DS_Store
.idea/
.vscode/
*.swp
EOF
    echo "✅ Created .gitignore file at $GITIGNORE_PATH"
fi

echo "✅ Sanitization completed!"
echo ""
echo "Files have been sanitized to remove or anonymize sensitive paths and references."
echo "The following changes were made:"
echo "  - Replaced hardcoded paths with environment variables"
echo "  - Anonymized usernames and hostnames"
echo "  - Replaced specific project references"
echo ""
echo "Original files have been backed up to: $BACKUP_DIR"
echo ""
echo "IMPORTANT: Review the sanitized files to ensure everything looks correct."
echo "If there are issues, you can restore from the backups directory."
echo ""
echo "Run 'git status' to see modified files before committing changes."
