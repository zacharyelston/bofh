#!/bin/bash
# Script to analyze YAML structure outliers in CFA ordering-atlas directories using Docker

# Get the directory where this script is located
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Set debugging flag (set to true to enable more verbose output)
DEBUG=${DEBUG:-false}

# Auto-detect CFA path if not provided
if [ -z "$CFA_PATH" ]; then
    # Try to find it relative to the script directory
    if [ -d "$(dirname "$(dirname "$(dirname "$SCRIPT_DIR")")")/CODE/CFA" ]; then
        export CFA_PATH="$(dirname "$(dirname "$(dirname "$SCRIPT_DIR")")")/CODE/CFA"
    else
        # Fall back to a relative path
        export CFA_PATH="../../../CODE/CFA"
        echo "Warning: CFA_PATH not specified and couldn't be auto-detected."
        echo "Using relative path: $CFA_PATH"
        echo "Set CFA_PATH environment variable if needed."
    fi
fi

# Set output path if not provided
if [ -z "$OUTPUT_PATH" ]; then
    export OUTPUT_PATH="$(dirname "$(dirname "$SCRIPT_DIR")")/output"
    mkdir -p "$OUTPUT_PATH"
fi

# Display message
echo "Analyzing CFA ordering-atlas YAML structures for outliers using Docker..."
echo "Base path: $CFA_PATH"
echo "Output path: $OUTPUT_PATH"

# First ensure that Docker and Python are working
echo "Testing Docker container..."
"$SCRIPT_DIR/docker-run.sh" test

if [ $? -ne 0 ]; then
    echo "Error: Docker container test failed. Please fix Docker setup first."
    exit 1
fi

# Run the analyzer in Docker with DEBUG flag
export DEBUG=$DEBUG

# Run the analyzer in Docker
echo "Running analysis..."
"$SCRIPT_DIR/docker-run.sh" outliers \
    --dir /data/cfa/sc-ordering-atlas \
    --pattern "*" \
    --threshold 50 \
    --output /data/output/cfa_outliers.json

# Check if the command was successful
if [ $? -ne 0 ]; then
    echo "Error: Failed to analyze YAML structures"
    echo "To get more debugging information, run:"
    echo "DEBUG=true $0"
    exit 1
fi

echo ""
echo "Analysis completed:"
echo "- JSON output: $OUTPUT_PATH/cfa_outliers.json"
echo ""
echo "Next steps:"
echo "1. Examine the outliers to identify patterns"
echo "2. Check if missing keys are intentional or errors"
echo "3. Use Docker to run queries for specific key values:"
echo "   ./docker-run.sh query --dir /data/cfa --query \"select name from metadata when kind is Deployment\""
