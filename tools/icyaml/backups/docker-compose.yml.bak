version: '3.8'

services:
  icyaml:
    build:
      context: .
      dockerfile: Dockerfile
    image: icyaml:latest
    container_name: icyaml
    volumes:
      - .:/app
      - ${CFA_PATH:-../../../CODE/CFA}:/data/cfa
      - ${OUTPUT_PATH:-../../../output}:/data/output
    environment:
      - CFA_PATH=${CFA_PATH:-../../../CODE/CFA}
      - OUTPUT_PATH=${OUTPUT_PATH:-../../../output}
    entrypoint: ["/bin/bash"]
    # Default command can be overridden on the command line
    command: ["-c", "echo 'ICYAML container ready. Use docker-compose run icyaml COMMAND to run specific commands.'"]
